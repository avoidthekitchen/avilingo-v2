{
  "name": "beakspeak",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --mode web",
    "build:native": "npm run content:check && tsc -b && vite build --mode native && bash ../scripts/prune-runtime-content.sh dist/content",
    "content:check": "cd .. && uv run python3 manual_audio.py --check",
    "native:sync": "npm run build:native && cap sync ios",
    "native:open": "cap open ios",
    "lint": "cd .. && eslint beakspeak scripts --config beakspeak/eslint.config.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:unit": "vitest run && node --test ../scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ios": "npm run native:sync && node ../scripts/ios-smoke.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "dexie": "^4.4.2",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-fsrs": "^5.3.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  }
}
